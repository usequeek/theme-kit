    "react-dom": ">=19",
    "@queekai/client-sdk": "*"
  },
  "dependencies": {
    "zustand": "^5.0.11",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "html-to-image": "^1.11.0"
  }
}
