{
  "name": "@usequeek/theme-kit",
  "version": "0.1.23",
  "private": false,
  "license": "MIT",
  "description": "The runtime a Queek storefront theme is built on: hooks, stores, page renderer, navigation, shared blocks and locale strings.",
  "keywords": [
    "queek",
    "storefront",
    "theme",
    "themes",
    "react",
    "nextjs",
    "commerce",
    "ecommerce"
  ],
  "homepage": "https://docs.usequeek.com/docs/themes",
  "bugs": {
    "url": "https://github.com/usequeek/theme-kit/issues"
  },
  "author": "Queekx Technology LTD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usequeek/theme-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "*.ts",
    "*.tsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.css",
    "locales/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!tests",
    "!scripts"
  ],
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "@queekai/client-sdk": "^0.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zustand": "^5.0.11",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "html-to-image": "^1.11.0"
  },
  "devDependencies": {
    "@queekai/client-sdk": "^0.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^28.1.0",
    "next": "^16.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "test": "node scripts/check-public-text.mjs && node --test scripts/check-public-text.test.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "verify-package": "tsx scripts/verify-package.ts"
  }
}
